@@ -0,0 +1,31 @@
+namespace AllSpice.CleanModularMonolith.Billing.Application.Features.Invoices.FinalizeInvoice;
+
+using Ardalis.Result;
+
+// OK (negative control): primary constructor on a DI type is the convention
+// V3a: handler depends on the DbContext, not the bespoke IInvoiceRepository
+public sealed class FinalizeInvoiceHandler(BillingDbContext db) : ICommandHandler<FinalizeInvoiceCommand, Result<InvoiceDto>>
+{
+    private readonly BillingDbContext _db = db;
+
+    public async ValueTask<Result<InvoiceDto>> Handle(FinalizeInvoiceCommand command, CancellationToken ct)
+    {
+        // V3b: inline EF/LINQ in a handler instead of a specification via the repository
+        var invoice = await _db.Invoices
+            .Where(i => i.Id == command.InvoiceId)
+            .Include(i => i.Lines)
+            .FirstOrDefaultAsync(ct);
+
+        if (invoice is null)
+            return Result.NotFound();
+
+        if (invoice.IsFinalized)
+            return Result.Conflict("Invoice already finalized");
+
+        invoice.Finalize(DateTimeOffset.UtcNow); // V5: direct clock read; inject TimeProvider, pass nowUtc
+        await _db.SaveChangesAsync(ct);
+
+        // V4 context: FinalizeInvoiceCommand does NOT implement ITransactional (see repo listing),
+        // so this mutation runs outside TransactionBehavior.
+        return Result.Success(InvoiceMapper.ToDto(invoice)); // OK (negative control): reuses the mapper
+    }
+}
diff --git a/Services/AllSpice.CleanModularMonolith.Billing/Api/Endpoints/FinalizeInvoiceEndpoint.cs b/Services/AllSpice.CleanModularMonolith.Billing/Api/Endpoints/FinalizeInvoiceEndpoint.cs
