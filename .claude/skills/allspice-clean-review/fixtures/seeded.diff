+namespace AllSpice.CleanModularMonolith.Billing.Domain.Entities;
+
+// V1: primary constructor on an entity (public ctor bypasses factory + guards)
+public sealed class InvoiceLine(Guid invoiceId, string description, decimal amount) : Entity
+{
+    public Guid InvoiceId { get; } = invoiceId;
+    public string Description { get; } = description;
+    public decimal Amount { get; private set; } = amount;
+
+    public void Reprice(decimal newAmount)
+    {
+        if (newAmount <= 0) throw new Exception("Amount must be positive"); // V2: bare Exception in Domain
+        Amount = newAmount;
+    }
+}
