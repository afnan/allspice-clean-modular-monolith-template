@@ -0,0 +1,29 @@
+namespace AllSpice.CleanModularMonolith.Billing.Api.Endpoints;
+
+public sealed class FinalizeInvoiceEndpoint(IMediator mediator) : Endpoint<FinalizeInvoiceRequest, InvoiceDto>
+{
+    public override void Configure()
+    {
+        Post("/billing/invoices/{id}/finalize");
+        // V6: no Policies(PermissionPolicy.For("billing:invoices.manage")) at all,
+        // and the key is not declared in BillingPermissionManifest either (see listing).
+    }
+
+    public override async Task HandleAsync(FinalizeInvoiceRequest req, CancellationToken ct)
+    {
+        var result = await mediator.Send(new FinalizeInvoiceCommand(req.Id), ct);
+        if (result.IsSuccess)
+        {
+            await SendOkAsync(result.Value, ct);
+            return;
+        }
+
+        // V7: hand-rolled status switch instead of result.ExecuteFailureAsync(HttpContext)
+        var status = result.Status switch
+        {
+            ResultStatus.NotFound => 404,
+            ResultStatus.Conflict => 409,
+            _ => 400
+        };
+        await SendAsync(new InvoiceDto(), status, ct);
+    }
+}
